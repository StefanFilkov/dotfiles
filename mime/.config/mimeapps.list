[Default Applications]

# --- Web Browsers ---
text/html=firefox.desktop
x-scheme-handler/http=firefox.desktop
x-scheme-handler/https=firefox.desktop
x-scheme-handler/about=firefox.desktop
x-scheme-handler/unknown=firefox.desktop

# --- Text & Code ---
text/plain=nvim.desktop
# text/plain=code.desktop # (Alternative: VS Code)

# --- Images ---
image/jpeg=imv.desktop
image/png=imv.desktop
image/gif=imv.desktop
image/webp=imv.desktop
image/svg+xml=imv.desktop

# --- Video & Audio ---
video/mp4=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop

# --- Documents ---
application/pdf=org.pwmt.zathura.desktop
# application/pdf=okularApplication.desktop # (Alternative: KDE Okular)

# --- File Managers ---
inode/directory=org.kde.dolphin.desktop
# inode/directory=yazi.desktop # (Alternative: Yazi)

# --- Archives ---
application/zip=org.kde.ark.desktop
application/x-tar=org.kde.ark.desktop
application/x-7z-compressed=org.kde.ark.desktop
x-scheme-handler/mailto=userapp-Thunderbird-N88MK3.desktop
message/rfc822=userapp-Thunderbird-N88MK3.desktop
x-scheme-handler/mid=userapp-Thunderbird-N88MK3.desktop
x-scheme-handler/viber=viber.desktop
x-scheme-handler/jetbrains=jetbrainsd.desktop
x-scheme-handler/claude-cli=claude-code-url-handler.desktop

[Added Associations]
x-scheme-handler/mailto=userapp-Thunderbird-N88MK3.desktop;
x-scheme-handler/mid=userapp-Thunderbird-N88MK3.desktop;
