[Unit]
Description=Waynaptics - Synaptics touchpad to mouse emulator
Documentation=https://github.com/kekekeks/waynaptics
After=local-fs.target systemd-udevd.service
# Keep retrying indefinitely if the touchpad node isn't ready at early boot
StartLimitIntervalSec=0

[Service]
Type=simple
# --device-name does a substring match on evdev device names; "Touchpad"
# uniquely matches the ELAN0676 touchpad on this machine. Edit if yours differs
# (list names: grep -A1 Touchpad /proc/bus/input/devices or `cat /sys/class/input/event*/device/name`).
ExecStart=/usr/bin/waynaptics --config /etc/waynaptics.conf --socket /var/run/waynaptics.sock --device-name Touchpad
Nice=-20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
